# Auth.js
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_URL=http://localhost:3000

# Resend（本番のマジックリンク送信用）
AUTH_RESEND_KEY=
AUTH_RESEND_FROM=noreply@your-domain.com

# Database
# ローカル: docker compose up -d のあと以下を使用
DATABASE_URL="postgresql://portal:portal@localhost:5432/student_portal"
# 本番: Neon / Vercel Postgres / Supabase などの接続文字列
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Google Calendar（任意）
# NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_URL=https://calendar.google.com/calendar/embed?src=...

# Mux 動画（任意・カンマ区切りで playback ID を講義回数順に指定）
# MUX_PLAYBACK_IDS=playbackId1,playbackId2,playbackId3,XP8bQlNaacRPgGCgB9CXlgvWnDaMiqgzzGqnNFXyBAU
